# Copy this file to `.env` and fill in real values.
# `.env` is gitignored, so nothing here ends up in the public repo.

# Real staff names (comma-separated). The importer matches sheet entries against
# this list. If unset, the app falls back to example names for the public demo.
CA_STAFF_NAMES=Alex Rivera,Jordan Lee,Sam Ravi Patel

# Path/URL to the roster workbook for `npm run import` (kept out of git).
# ROSTER_FILE=/absolute/path/to/roster.xlsx

# Optional
# PORT=5000
# ROSTER_YEAR=2026
